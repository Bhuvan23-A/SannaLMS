generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LiveClass {
  id           String   @id @default(uuid())
  tenant_id    String
  course_id    String
  title        String
  description  String?
  host_user_id String
  room_name    String   @unique  // Jitsi room name (slug)
  scheduled_at DateTime
  duration_mins Int     @default(60)
  is_live      Boolean  @default(false)
  // Set once when the class is ended; a class that has ended cannot be
  // restarted (the UI shows "Ended" instead of "Go Live" again).
  ended_at     DateTime?
  recording_url String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}
