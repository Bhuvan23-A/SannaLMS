generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id          String   @id @default(uuid())
  tenant_id   String
  course_id   String
  title       String
  date        DateTime
  qr_token    String?  @unique  // For QR-based check-in
  location    String?           // For GPS-based check-in
  lat         Float?
  lng         Float?
  radius_m    Int?     @default(100) // GPS radius in meters
  created_at  DateTime @default(now())

  records     AttendanceRecord[]
}

model AttendanceRecord {
  id          String   @id @default(uuid())
  session_id  String
  user_id     String
  tenant_id   String
  status      String   @default("PRESENT")  // PRESENT, ABSENT, LATE
  method      String   @default("MANUAL")   // MANUAL, QR, GPS
  check_in_at DateTime @default(now())

  session     Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, user_id])
}
