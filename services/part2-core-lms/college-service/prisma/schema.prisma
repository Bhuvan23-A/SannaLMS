generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  PRIMARY_TRAINER
  TEACHING_ASSISTANT
  GUEST_FACULTY
  STUDENT
}

// ----------------------------------------------------------------------
// ORG HIERARCHY
// ----------------------------------------------------------------------

model College {
  id         String    @id @default(uuid())
  name       String
  subdomain  String    @unique // e.g. 'stanford.lms.com'
  
  // Mandatory Standard Fields
  tenant_id  String?   // Self-referential for root tenant
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  departments Department[]
  users       UserRole[]
}

model Department {
  id         String    @id @default(uuid())
  name       String
  college_id String
  
  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  college  College  @relation(fields: [college_id], references: [id])
  branches Branch[]
}

model Branch {
  id            String    @id @default(uuid())
  name          String
  department_id String
  
  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  department Department @relation(fields: [department_id], references: [id])
  semesters  Semester[]
}

model Semester {
  id         String    @id @default(uuid())
  name       String    // e.g. "Fall 2026"
  branch_id  String
  
  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  branch Branch @relation(fields: [branch_id], references: [id])
}

// ----------------------------------------------------------------------
// RBAC & USERS
// ----------------------------------------------------------------------

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  first_name String
  last_name  String
  
  // Mandatory Standard Fields
  tenant_id  String?   // Optional if a user belongs to multiple colleges
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  roles UserRole[]
}

model UserRole {
  id         String    @id @default(uuid())
  user_id    String
  college_id String
  role       Role
  
  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  user    User    @relation(fields: [user_id], references: [id])
  college College @relation(fields: [college_id], references: [id])

  @@unique([user_id, college_id, role])
}
