generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
}

enum MembershipStatus {
  ACTIVE
  COMPLETED // promoted / graduated out of this section
  DROPPED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AssetStatus {
  UPLOADING
  SCANNING
  PROCESSING
  READY
  FAILED
}

enum AssetType {
  VIDEO
  DOCUMENT
  SCORM
  QUIZ
}

// ----------------------------------------------------------------------
// SUBJECT CATALOG (college-accurate, stage 2)
// ----------------------------------------------------------------------

// A catalog subject: "Data Structures" (CS201, 4 credits). Defined once;
// offerings (Course rows) are instances of a subject taught to a Section.
model Subject {
  id            String @id @default(uuid())
  tenant_id     String
  code          String // "CS201" — auto-generated ("SUB-###") if blank
  name          String
  description   String?
  department_id String? // logical ref to college-service
  branch_id     String? // program this subject belongs to
  credits       Int    @default(3)
  lt_p          String? // "3-1-0" lecture-tutorial-practical
  status        CourseStatus @default(DRAFT)

  // Mandatory Standard Fields
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  modules   Module[] // syllabus owned by the subject
  offerings Course[] // CourseOffering instances

  @@unique([tenant_id, branch_id, code])
  @@index([tenant_id, department_id])
}

// ----------------------------------------------------------------------
// COURSE ENGINE
// ----------------------------------------------------------------------

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  // Org targeting (#fix): which department / branch / semester + year the
  // course is offered to (IDs reference the college-service org hierarchy).
  department_id String?
  branch_id     String?
  semester_id   String?
  year          String? // DEPRECATED (stage-2 of college-accurate schema drops it)

  // College-accurate fields (stage 1): subject identity + cohort targeting.
  // Stage 2 adds the structured Subject/Section pointers below; these scalar
  // columns are mirrored from them for display/back-compat (deprecated later).
  subject_code    String? // e.g. "CS201" — the catalog code of this subject
  credits         Int?    // e.g. 4 — weight of this subject (override; inherit from subject)
  section         String? // class section: "A", "B", "C" (empty = unsplit class)
  academic_session String? // running academic year, e.g. "2026-27"
  year_of_study   Int?    // 1..4 — the year of study this course targets

  // Stage-2 structured pointers (college-accurate schema): an offering is an
  // instance of a Subject taught to a Section (cohort). subject_id is a real
  // relation (same DB); section_id is a logical ref to the college-service DB.
  subject_id      String?
  section_id      String?
  semester_number Int? // denormalized from the section (1..8)

  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  modules       Module[]
  trainers      CourseTrainer[]
  enrollments   Enrollment[]
  prerequisites CoursePrerequisite[]
  history       CourseVersionHistory[]
  resources     CourseResource[]
  subject       Subject? @relation(fields: [subject_id], references: [id])
}

// Files (PDFs, documents, links) attached at the course level — the "Resources"
// section trainers can upload per course (#6).
model CourseResource {
  id           String   @id @default(uuid())
  tenant_id    String
  course_id    String
  title        String
  file_name    String
  file_path    String
  file_size    Int      @default(0)
  content_type String?
  created_at   DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@index([course_id])
}

model CourseTrainer {
  id        String @id @default(uuid())
  course_id String
  user_id   String // Foreign key to the User in college-service (logical reference)
  role      String @default("PRIMARY_TRAINER") // e.g., PRIMARY_TRAINER, TEACHING_ASSISTANT, GUEST_FACULTY

  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  course Course @relation(fields: [course_id], references: [id])

  @@unique([course_id, user_id])
}

// The class roster: one row per student per Section. Enrolling a student in a
// section auto-enrolls them in every active offering of that section.
model SectionMembership {
  id          String           @id @default(uuid())
  tenant_id   String
  section_id  String           // logical ref to college-service Section
  user_id     String           // student (logical ref to college-service User)
  status      MembershipStatus @default(ACTIVE)
  enrolled_at DateTime         @default(now())

  // Mandatory Standard Fields
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  @@unique([section_id, user_id])
  @@index([user_id, status])
}

model Module {
  id          String  @id @default(uuid())
  title       String
  course_id   String? // NULL when the module belongs only to the Subject syllabus
  subject_id  String? // syllabus owned by the Subject (shared across offerings)
  sequence_no Int     @default(1)

  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  course  Course?  @relation(fields: [course_id], references: [id])
  subject Subject? @relation(fields: [subject_id], references: [id])
  lessons Lesson[]
}

model Lesson {
  id          String @id @default(uuid())
  title       String
  module_id   String
  sequence_no Int    @default(1)

  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  module Module  @relation(fields: [module_id], references: [id])
  topics Topic[]
}

model Topic {
  id          String  @id @default(uuid())
  title       String
  content     String? // Rich text or video URL placeholder
  lesson_id   String
  sequence_no Int     @default(1)

  // Mandatory Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  lesson Lesson         @relation(fields: [lesson_id], references: [id])
  asset  AssetMetadata?
}

// ----------------------------------------------------------------------
// ENROLLMENTS & PROGRESS
// ----------------------------------------------------------------------

model Enrollment {
  id           String           @id @default(uuid())
  user_id      String // From college-service
  course_id    String
  status       EnrollmentStatus @default(ACTIVE)
  enrolled_at  DateTime         @default(now())
  completed_at DateTime?

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  course Course @relation(fields: [course_id], references: [id])

  // auto_enrolled=true means the enrollment came from section membership
  // (auto-enroll in every offering of the section). Manual/elective enrollments
  // are false. section_id denormalized for roster-level queries.
  auto_enrolled Boolean  @default(false)
  section_id    String?

  @@unique([user_id, course_id])
  @@index([section_id])
}

model TopicProgress {
  id               String         @id @default(uuid())
  user_id          String
  topic_id         String
  status           ProgressStatus @default(NOT_STARTED)
  last_accessed_at DateTime       @default(now())
  completed_at     DateTime?

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  video_progress VideoProgress?
  quiz_progress  QuizProgress?

  @@unique([user_id, topic_id])
}

model VideoProgress {
  id                   String @id @default(uuid())
  topic_progress_id    String @unique
  last_second_watched  Int    @default(0)
  percentage_completed Float  @default(0)

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  topic_progress TopicProgress @relation(fields: [topic_progress_id], references: [id])
}

model QuizProgress {
  id                String  @id @default(uuid())
  topic_progress_id String  @unique
  score             Float?
  passed            Boolean @default(false)

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  topic_progress TopicProgress @relation(fields: [topic_progress_id], references: [id])
}

// ----------------------------------------------------------------------
// CONTENT ENGINE & ASSETS
// ----------------------------------------------------------------------

model AssetMetadata {
  id            String      @id @default(uuid())
  topic_id      String?     @unique
  type          AssetType
  status        AssetStatus @default(UPLOADING)
  physical_path String?
  original_name String?
  checksum      String?
  file_size     Int?

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  topic          Topic?         @relation(fields: [topic_id], references: [id])
  video_metadata VideoMetadata?
}

model VideoMetadata {
  id               String  @id @default(uuid())
  asset_id         String  @unique
  thumbnail_path   String?
  preview_path     String?
  subtitle_path    String?
  hls_stream_url   String?
  duration_seconds Int?

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  asset AssetMetadata @relation(fields: [asset_id], references: [id])
}

// ----------------------------------------------------------------------
// RULES & VERSIONING
// ----------------------------------------------------------------------

model CoursePrerequisite {
  id                 String @id @default(uuid())
  course_id          String
  required_course_id String // The course that must be completed first

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  course Course @relation(fields: [course_id], references: [id])

  @@unique([course_id, required_course_id])
}

model CourseVersionHistory {
  id             String   @id @default(uuid())
  course_id      String
  version_number Int
  snapshot_data  Json // Full serialized curriculum state at publish time
  published_at   DateTime @default(now())
  published_by   String?

  // Standard Fields
  tenant_id  String
  version    Int       @default(1)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  created_by String?
  updated_by String?
  deleted_by String?

  course Course @relation(fields: [course_id], references: [id])

  @@unique([course_id, version_number])
}

// ----------------------------------------------------------------------
// SEMESTER PROMOTION
// ----------------------------------------------------------------------

// One row per student promoted from one semester to the next (audit trail).
// branch_id / semester IDs reference the college-service org hierarchy.
// Stage 2: sections carry the cohort — from_section_id/to_section_id are the
// canonical pointers; semester IDs kept for the audit trail.
model Promotion {
  id               String   @id @default(uuid())
  tenant_id        String
  branch_id        String
  from_semester_id String?
  to_semester_id   String?
  from_section_id  String?
  to_section_id    String?
  student_id       String
  promoted_by      String?
  created_at       DateTime @default(now())

  @@index([tenant_id, branch_id, from_semester_id])
  @@index([tenant_id, from_section_id])
}
